# Backend environment variables
# Copy to .env (git-ignored) and fill in. Variable names mirror every
# process.env.* reference in backend/src.

# ---------- Required ----------
# validateEnv() in src/config/env.js throws at boot if any of these is missing.
PORT=5000
# Signs and verifies the JWT issued by auth.controller.js. Use a long random
# string; changing it invalidates every token already in the wild.
JWT_SECRET=

# ---------- Database (required unless DATABASE_URL is set) ----------
# Local default is a plain Postgres on 5432 with a `velora_db` database.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=velora_db
DB_USER=postgres
DB_PASSWORD=
# "true" enables TLS with rejectUnauthorized:false. Managed Postgres (Supabase,
# RDS, Neon) needs true; a local server needs false.
DB_SSL=false

# A single connection string instead of the five DB_* vars above. When set it
# takes precedence and the DB_* vars are not required.
# DATABASE_URL=postgresql://user:password@host:5432/database

# ---------- CORS ----------
# Comma-separated list of browser origins allowed to call this API. Any
# localhost/127.0.0.1 port is allowed automatically when NODE_ENV is not
# "production", so this only has to be set for a real deployment. Leaving it
# empty in production blocks every cross-origin request.
FRONTEND_URL=http://localhost:5173

# ---------- Optional ----------
# "production" serves Frontend/dist from this process and tightens CORS.
NODE_ENV=development
# Token lifetime, as an ms/zeit string. Defaults to 7d.
JWT_EXPIRES_IN=7d

# AI style suggestions (src/services/ai.service.js). Tried in this order and
# each is skipped when its key is missing; with none set the service falls back
# to its built-in DEFAULT_SUGGESTIONS, so the endpoints still answer.
OPENROUTER_API_KEY=
AISTUDIO_API_KEY=
GROQ_API_KEY=

# Image uploads (src/services/image.service.js). All three must be present or
# uploads are written to public/uploads on local disk instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Outbound email for the Google/Apple confirmation codes (auth.controller.js).
# Without these the code is logged to the console and returned to the client as
# `debugCode`, which is fine locally and must not be relied on in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
