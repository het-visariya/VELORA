# === Dependencies ===
node_modules/
backend/node_modules/
Frontend/node_modules/

# === Environment & Secrets ===
# Ignore every .env variant anywhere (.env, .env.local, .env.bak, .env.production...)
# and then re-admit only the committed templates.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# === Build Output ===
dist/
backend/dist/
Frontend/dist/

# === Logs ===
*.log
backend-*.err.log
backend-*.out.log
frontend-*.err.log
frontend-*.out.log

# === OS Files ===
.DS_Store
Thumbs.db
desktop.ini

# === IDE & Editor ===
.vscode/
.idea/
*.swp
*.swo
*~

# === Temp Files ===
_ul
tmp/
temp/

# === 3D Models ===
# Source assets: originals live here, never committed (71 MB).
assets-src/
# Web-ready models are GENERATED by `npm run build:models` - never committed.
backend/public/models/*.fbx
backend/public/models/*.glb
backend/public/uploads/*
# Stray model files at the repo root (should be moved to assets-src/)
/*.fbx
/*.glb

# === Screenshots ===
# Only screenshots are ignored. A blanket *.png/*.jpg rule used to live here,
# which silently swallowed texture and source-image assets.
Screenshot*.png
Screenshot*.jpg
Screenshot*.jpeg

